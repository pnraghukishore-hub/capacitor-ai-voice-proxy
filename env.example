# capacitor-ai-voice-proxy — Local development secrets
# Copy this file to .dev.vars and fill in your values.
# NEVER commit .dev.vars to git — it is gitignored.
#
# For production, set secrets via Wrangler:
#   wrangler secret put GOOGLE_SPEECH_API_KEY
#   wrangler secret put FIREBASE_PROJECT_ID

# ── Required ──────────────────────────────────────────────────────────────

# GCP API key with both APIs enabled:
#   - Cloud Speech-to-Text API
#   - Cloud Text-to-Speech API
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_SPEECH_API_KEY=AIzaSy...your-key-here

# Your Firebase project ID
# Get from: Firebase Console → Project Settings → General
FIREBASE_PROJECT_ID=your-project-12345
